# ─────────────────────────────────────────────────────────
# KneeXpert monorepo — unified ignore rules
# ─────────────────────────────────────────────────────────

# === Python (backend) ===
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Node (frontend) ===
node_modules/
dist/
dist-ssr/
*.local
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Environment files (local config / secrets — never committed) ===
# Applies to both backend/ and frontend/. The .env.example templates ARE tracked.
.env
.env.*
!.env.example

# === Model checkpoints (kept local, never committed) ===
**/models/*
!**/models/
!**/models/.gitkeep
*.pth
*.pt
*.pth.tar
*.ckpt
*.h5
*.keras
*.onnx
*.safetensors
*.pb
*.tflite
*.mlmodel

# === Medical imaging & large volumes ===
*.nii
*.nii.gz
*.nrrd
*.nhdr
*.mha
*.mhd
*.img
*.hdr
*.mnc
*.par
*.rec
*.dcm
*.dicom

# Local sample volumes (metadata in data/ may still be tracked)
backend/data/samples/*
!backend/data/samples/
!backend/data/samples/.gitkeep

# === Large archives & model bundles (kept out of git) ===
*.zip
Models-*/
Test data*/

# === Notebook outputs ===
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# === Ad-hoc exports / caches ===
*.pkl
*.pickle
*.npz
*.npy
*.hdf5
*.cache

# === OS / IDE ===
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
