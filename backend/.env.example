# KneeXpert backend — local configuration template.
#
# Copy to backend/.env and edit. Every value below has a working default, so the
# API starts with no .env at all; these only need setting when you move
# generation to another host, tune the safety gate, or harvest the corpus.
#
# backend/.env is gitignored. Do not commit real values.

# ── Generation host (Ollama) ──────────────────────────────────────────────────
# The ONLY thing that changes when generation moves between your laptop, a rented
# GPU box, or an institutional server. No code change is needed.
#   local Ollama                  http://localhost:11434
# Backend in Docker, Ollama on the host:
#                                 http://host.docker.internal:11434
#   rented GPU box over a tunnel  http://<host-or-ip>:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model tag as registered with Ollama. Create it once from the committed Modelfile:
#   ollama run hf.co/mradermacher/Meditron3-8B-GGUF:Q4_K_M
#   ollama create meditron3-8b -f rag/Modelfile.meditron3
OLLAMA_MODEL=meditron3-8b

# Seconds to wait for a full generation. A 300-token note takes roughly 6-10 s on
# a T4 and 50-100 s on a CPU-only laptop, so raise this if you run without a GPU.
OLLAMA_TIMEOUT_S=120

# Context window, in tokens. MUST be set explicitly: Ollama defaults to 2048
# regardless of the model's 128K capability and then silently truncates FROM THE
# LEFT, discarding the system prompt's safety rules first.
OLLAMA_NUM_CTX=8192

# ── Retrieval and safety gate ─────────────────────────────────────────────────
# Groundedness thresholds, one per part of the note. A note is served only if its
# synthesis clears RAG_TAU and its next steps clear RAG_TAU_NEXT_STEPS; otherwise
# it is regenerated and, after the retry budget, withheld entirely rather than
# shown. Both are provisional until the Phase 4 sweep picks an operating point.
# 0.70 rejected every note, including well-grounded ones.
RAG_TAU=0.60
# Defaults to RAG_TAU when unset.
RAG_TAU_NEXT_STEPS=0.60

# Generation seed. Fixed so evaluation runs are reproducible.
RAG_SEED=42

# Embedding model (local, in-process).
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Entailment model for the safety gate (local, in-process). The default is ~740 MB
# resident and 100-400 ms/pair on integrated graphics; switch to a smaller MNLI
# variant on a weak machine, and record which one produced any reported numbers.
RAG_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# ── Corpus harvesting (only needed to run `python -m rag.harvest`) ────────────
# NCBI E-utilities requires an identifying tool name and expects a contact
# address. WITHOUT NCBI_EMAIL, requests are redirected to NCBI's abuse page — an
# HTTP 302 that looks like an ordinary redirect until you read the body.
# This is sent to NCBI, a third party, so it is deliberately not defaulted.
NCBI_TOOL=KneeXpert-RAG
NCBI_EMAIL=

# Optional. Raises the rate limit from 3 to 10 requests/second.
# Free from https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# ── Model cache location (set in your shell, not read from this file) ─────────
# HuggingFace caches weights under the user profile on C: by default. On a machine
# where C: is tight, point it at a roomier drive:
#   HF_HOME=D:/path/with/space/.hf-cache
#   HF_HUB_DISABLE_SYMLINKS_WARNING=1
