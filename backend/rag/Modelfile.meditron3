# Meditron3-8B for KneeXpert clinical notes.
#
#   ollama pull hf.co/mradermacher/Meditron3-8B-GGUF:Q4_K_M
#   ollama create meditron3-8b -f rag/Modelfile.meditron3
#   ollama list                       # expect meditron3-8b
#
# Committed deliberately. Quantised community GGUF conversions do not reliably
# carry a usable chat template in their metadata, and without the correct
# Llama-3.1 template and stop tokens the model keeps generating past its turn and
# appends a fabricated next exchange. The safety gate would then dutifully score
# that invented text as if it were part of the note.
#
# Meditron3-8B is continued-pretrained from Llama-3.1-8B-Instruct, so the
# Llama-3.1 template is the correct one.

FROM hf.co/mradermacher/Meditron3-8B-GGUF:Q4_K_M

TEMPLATE """<|begin_of_text|>{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

"""

PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
PARAMETER stop "<|start_header_id|>"

# Context length is also sent explicitly on every request, because Ollama's
# default of 2048 silently truncates the prompt from the left and would discard
# the system message's safety rules first. Setting it here too means a manual
# `ollama run` behaves like the application does.
PARAMETER num_ctx 8192

# Low by default: this model drafts clinical text that must stay close to its
# evidence. The application overrides per attempt (0.2 -> 0.1 -> 0.0 on retry).
PARAMETER temperature 0.2
